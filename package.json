{
  "name": "ts-boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prestart:local": "npm run obfuscateScan",
    "start:local": "vite",
    "prestart:dev": "npm run obfuscateScan",
    "start:dev": "eslint src --max-warnings=2 && vite --mode development --host",
    "prestart:production": "npm run obfuscateScan",
    "start:production": "eslint src --max-warnings=2 && vite --mode production --host",
    "pretypecheck": "npm run obfuscateScan",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run obfuscateScan",
    "build": "eslint src --max-warnings=2 && tsc && vite build",
    "prebuild:dev": "npm run obfuscateScan",
    "build:dev": "eslint src --max-warnings=2 && tsc && vite build --mode development",
    "prelint:fix": "npm run obfuscateScan",
    "lint:fix": "eslint src --fix --max-warnings=2",
    "prelint:check": "npm run obfuscateScan",
    "lint:check": "eslint src --max-warnings=2",
    "prepreview": "npm run obfuscateScan",
    "preview": "vite preview",
    "pretest": "npm run obfuscateScan",
    "test": "vitest",
    "preprepare": "npm run obfuscateScan",
    "prepare": "husky",
    "pretest:run": "npm run obfuscateScan",
    "test:run": "vitest --run",
    "preformat": "npm run obfuscateScan",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preverify": "npm run obfuscateScan",
    "verify": "tsc --noEmit && eslint src --max-warnings=2 && vitest --run && tsc && vite build",
    "obfuscateScan": "node obfuscateScan.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@magic-ext/oauth2": "^15.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "ethers": "^6.16.0",
    "firebase": "^12.11.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.575.0",
    "magic-sdk": "^33.4.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "socket.io": "^4.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
